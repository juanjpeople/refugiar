{
  "name": "opendomus",
  "version": "0.1.0",
  "description": "El sistema operativo de tu casa. Que vive en tu casa.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "server"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-export-segments.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/test-hooks.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p server/tsconfig.test.json",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply opendomus --remote",
    "db:migrate:local": "wrangler d1 migrations apply opendomus --local"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  }
}
