{
  "name": "opendomus",
  "version": "0.1.0",
  "description": "El sistema operativo de tu casa. Que vive en tu casa.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "server"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "package:local": "node scripts/package-local.mjs",
    "dist:local": "npm run build:local && npm run package:local",
    "start": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard",
    "preview:lan": "serve out --listen tcp://0.0.0.0:4173 --no-clipboard",
    "lint": "eslint",
    "test": "node --import ./scripts/test-hooks.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.mjs\" \"server/test/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p server/tsconfig.test.json",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply opendomus --remote",
    "db:migrate:local": "wrangler d1 migrations apply opendomus --local",
    "admin": "node server/scripts/admin.ts",
    "admin:access": "node server/scripts/setup-operator.ts",
    "e2e:local": "playwright test --config playwright.local.config.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "serve": "14.2.6",
    "typescript": "^5"
  }
}
