// Cloudflare: un solo Worker para la app (archivos estáticos de `out/`) y la API (`/api/*`, en
// `server/`). Mismo origen: cookies de sesión de primera parte, sin CORS en producción.
// En el panel: Build command `npm run build` · Deploy command `npx wrangler deploy`.
// Base: `npm run db:migrate` (producción) / `npm run db:migrate:local` (desarrollo).
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "opendomus",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Páginas inexistentes → 404.html, que además traduce URLs viejas (los QR impresos /c/<código>).
    "not_found_handling": "404-page",
    // Solo la API pasa por el código del Worker; la app se sirve directo (más rápido y sin costo).
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opendomus",
      "database_id": "0a293208-b372-43e6-b78a-f931df22bbb8",
      "migrations_dir": "server/migrations",
    },
  ],
  // Un Durable Object por casa: ordena los cambios cifrados y avisa en tiempo real (server/src/sync.ts).
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD", "class_name": "HouseholdLog" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdLog"] }],
  "vars": {
    "APP_ORIGIN": "https://opendomus.juanjpeople.workers.dev",
    // Bucket privado: guarda solo bytes cifrados. La service role se configura como secreto.
    "SUPABASE_URL": "https://qaeqyeadwijphhlqcrku.supabase.co",
    "SUPABASE_PHOTOS_BUCKET": "opendomus-photos",
    "PHOTO_STORAGE": "supabase",
    // OPERATOR_ACCESS_ISSUER, OPERATOR_ACCESS_AUD y OPERATOR_EMAILS se configuran fuera del repo.
    // Crear una casa en la nube pide una licencia (en desarrollo, `.dev.vars` puede poner `open`).
    "HOUSEHOLD_ACCESS": "codes",
  },
  // Procesa avisos y pausa casas inactivas una vez por día. Nunca borra automáticamente.
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true },
}
